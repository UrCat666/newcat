# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL of the store (used for receipt links in WhatsApp messages & SEO).
APP_URL="http://localhost:3000"

# BOOTSTRAP_ADMIN_EMAILS: Comma-separated list of Google/Firebase Auth emails granted admin access on bootstrap.
# Never put passwords here. Authentication is handled via Firebase Auth.
BOOTSTRAP_ADMIN_EMAILS="admin@example.com"

# FIREBASE_SERVICE_ACCOUNT_KEY: Optional JSON string (or file path) of Firebase Admin Service Account
# for direct server-side Firestore persistence in production deployments.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# RECEIPT_TOKEN_PEPPER: Server-side secret pepper used when hashing receipt tokens (SHA-256).
# Change this to a long random string in production.
RECEIPT_TOKEN_PEPPER="change-this-to-a-long-random-secret-in-production"
